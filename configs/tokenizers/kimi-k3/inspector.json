{
  "format": "tiktoken",
  "vocab_file": "tiktoken.model",
  "special_tokens_file": "tokenizer_config.json",
  "reserved_special_tokens": 256,
  "pattern": "[\\p{Han}]+|[^\\r\\n\\p{L}\\p{N}]?[\\p{Lu}\\p{Lt}\\p{Lm}\\p{Lo}\\p{M}-[\\p{Han}]]*[\\p{Ll}\\p{Lm}\\p{Lo}\\p{M}-[\\p{Han}]]+(?i:'s|'t|'re|'ve|'m|'ll|'d)?|[^\\r\\n\\p{L}\\p{N}]?[\\p{Lu}\\p{Lt}\\p{Lm}\\p{Lo}\\p{M}-[\\p{Han}]]+[\\p{Ll}\\p{Lm}\\p{Lo}\\p{M}-[\\p{Han}]]*(?i:'s|'t|'re|'ve|'m|'ll|'d)?|\\p{N}{1,3}| ?[^\\s\\p{L}\\p{N}]+[\\r\\n]*|\\s*[\\r\\n]+|\\s+(?!\\S)|\\s+"
}
